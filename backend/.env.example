# Conexión a PostgreSQL (usuario:clave@host:puerto/base)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/foodstore_db
# Firma del JWT: mínimo 32 caracteres (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origen del frontend permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173
# true solo si se sirve por HTTPS
COOKIE_SECURE=false
